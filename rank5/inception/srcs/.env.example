# Copy this file to .env and adjust the values for your login.
# Passwords must NOT be stored here: put them in ../secrets/*.txt instead.
DOMAIN_NAME=login.42.fr

# MySQL/MariaDB Configuration
MYSQL_DATABASE=wordpress_db
MYSQL_USER=wp_user

# WordPress Configuration
WP_ADMIN_USER=login
WP_ADMIN_EMAIL=login@student.42.fr
WP_USER=wp_author
WP_USER_EMAIL=author@student.42.fr
WP_TITLE=Inception WordPress Site
WP_PORT=443
WP_URL=https://login.42.fr

# Paths
DATA_PATH=/home/login/data
